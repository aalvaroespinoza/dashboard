{
  "name": "dashboard-tablet",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "^57.0.16",
    "expo-asset": "~57.0.14",
    "expo-audio": "~57.0.4",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "^57.0.3",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.2",
    "fast-xml-parser": "^5.11.0",
    "lucide-react-native": "^1.34.0",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "prebuild": "expo prebuild",
    "build:apk": "npx expo prebuild --clean && cd android && ./gradlew assembleRelease --no-daemon --build-cache --parallel",
    "build:apk:win": "npx expo prebuild --clean && cd android && .\\gradlew.bat assembleRelease --no-daemon --build-cache --parallel",
    "build:apk:local": "powershell -ExecutionPolicy Bypass -File ./scripts/build_local_apk.ps1",
    "build:eas": "eas build -p android --profile preview"
  },
  "private": true
}
